theme = Horizon

font-family = "Monaspace Neon N"
font-size = 12.0

window-height = 35
window-width = 120
window-padding-x = 12
window-padding-y = 12

quit-after-last-window-closed = true
mouse-shift-capture = never

macos-auto-secure-input = true
macos-option-as-alt = true
macos-titlebar-style = hidden
macos-icon = glass

keybind = global:cmd+ctrl+t=toggle_quick_terminal

# herdr cycles its tabs with ctrl+tab. Unbinding isn't enough: AppKit's native
# tab switching then eats the key. A GTK-only action is a no-op on macOS, and
# unconsumed: still sends the key on to herdr.
keybind = unconsumed:ctrl+tab=show_gtk_inspector
keybind = unconsumed:ctrl+shift+tab=show_gtk_inspector

# Send ctrl+Home/End instead of the default ctrl+a / ctrl+e: ctrl+a is herdr's
# prefix, so it never reaches the app underneath. Bare Home/End is no good
# either — pi's fullscreen TUI binds those to scroll top/bottom.
keybind = super+arrow_left=esc:[1;5H
keybind = super+arrow_right=esc:[1;5F

