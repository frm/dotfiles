#!/usr/bin/env zsh
# rebases the current branch onto the latest origin/<destination>
#
# usage: git rebase-main [--stack] [--reattach] [destination]
#   destination: branch to rebase onto (default: main, or master)
#   --stack:     also move the stack's branch refs held by other worktrees
#   --reattach:  put detached worktrees back on their branches
#
# git's --update-refs skips branches checked out in a worktree, which is every
# branch of a stack here. --stack detaches those worktrees first so the refs
# move, then reattaches them. a rebase that stops on conflicts leaves them
# detached until --reattach runs, since the refs only move once it finishes.
#
# the local destination ref is fast-forwarded as a convenience, but the rebase
# always targets origin/<destination>, so a destination that can't advance
# (dirty worktree, diverged) never blocks the rebase.
#
# the todo editor only opens when the branch carries more than one commit,
# since that's when there's something to squash or reorder.

set -e

source $DOTFILES/functions/helpers.zsh

# `!` git aliases export these pinned to the calling worktree, which makes every
# `git -C <other worktree>` below run against this worktree's HEAD and index.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

#
# aux functions
#

__git_rbm_infer_destination() {
  if git branch-check main; then
    echo "main"
  elif git branch-check master; then
    echo "master"
  else
    _mnds_pp_error "git" "couldn't infer destination branch, pass one explicitly" >&2
    return 1
  fi
}

# path of the worktree holding a branch, empty when it isn't checked out
__git_rbm_worktree_of() {
  local branch="$1"

  git worktree list --porcelain \
    | awk -v ref="refs/heads/$branch" '
      /^worktree / { path = substr($0, 10) }
      $0 == "branch " ref { print path; exit }
    '
}

# fast-forward the local destination ref. a checked-out branch can't be fetched
# into, so that case merges inside its own worktree instead.
__git_rbm_advance_destination() {
  local destination="$1"
  local worktree=$(__git_rbm_worktree_of "$destination")

  if [[ -z "$worktree" ]]; then
    git fetch --quiet origin "$destination:$destination" 2>/dev/null
    return
  fi

  git -C "$worktree" merge --quiet --ff-only "origin/$destination" >/dev/null 2>&1
}

# git's refusal is either silent (--quiet fetch) or multi-line, so the reason is
# worked out here instead of parroted back.
__git_rbm_refusal_reason() {
  local destination="$1"
  local worktree=$(__git_rbm_worktree_of "$destination")

  if ! git merge-base --is-ancestor "$destination" "origin/$destination"; then
    echo "it has diverged from origin/$destination"
    return
  fi

  echo "its worktree at $worktree has changes in the way"
}

__git_rbm_abort_on_conflict() {
  _mnds_pp_error "git" "rebase stopped on conflicts"
  _mnds_pp_neutral "git" "resolve them, 'git add' each file, then 'git rbc' — or 'git rb --abort' to bail"

  [[ -f "$(__git_rbm_state_file)" ]] \
    && _mnds_pp_neutral "git" "worktrees stay detached until you run 'git rbm --reattach' afterwards"

  exit 1
}

#
# stack detaching
#

__git_rbm_state_file() {
  echo "$(git rev-parse --git-common-dir)/rbm-stack-detached"
}

# the branches --update-refs would move: everything reachable from HEAD but not
# from the destination. one that has advanced past its fork point drops out,
# which is correct — the rebase wouldn't move it either.
__git_rbm_stack_branches() {
  local destination="$1"

  comm -23 \
    <(git branch --format='%(refname:short)' --merged HEAD | sort) \
    <(git branch --format='%(refname:short)' --merged "$destination" | sort)
}

__git_rbm_detach() {
  local destination="$1"
  local current=$(git rev-parse --show-toplevel)
  local state=$(__git_rbm_state_file)

  rm -f "$state"

  local stacked worktree

  for stacked in $(__git_rbm_stack_branches "$destination"); do
    worktree=$(__git_rbm_worktree_of "$stacked")

    [[ -n "$worktree" && "$worktree" != "$current" ]] || continue

    _mnds_pp_neutral "git" "  detaching $stacked"
    git -C "$worktree" checkout --quiet --detach
    printf '%s\t%s\n' "$worktree" "$stacked" >> "$state"
  done
}

# a worktree whose checkout fails keeps its line, so a later --reattach retries
# only what's left.
__git_rbm_reattach() {
  local state=$(__git_rbm_state_file)

  [[ -f "$state" ]] || return 0

  local pending=$(mktemp)
  local detached stacked

  while IFS=$'\t' read -r detached stacked; do
    [[ -n "$detached" && -n "$stacked" ]] || continue

    if git -C "$detached" checkout --quiet "$stacked" 2>/dev/null; then
      _mnds_pp_neutral "git" "  reattached $stacked"
      continue
    fi

    _mnds_pp_warn "git" "left $stacked detached: $detached has changes in the way"
    _mnds_pp_neutral "git" "  stash or commit them, then 'git -C $detached checkout $stacked'"
    printf '%s\t%s\n' "$detached" "$stacked" >> "$pending"
  done < "$state"

  rm -f "$state"
  [[ -s "$pending" ]] && mv "$pending" "$state" || rm -f "$pending"
}

__git_rbm_rebase() {
  local destination="$1"
  local incoming=$(git rev-list --count "HEAD..origin/$destination")
  local mine=$(git rev-list --count "origin/$destination..HEAD")

  if (( incoming == 0 )); then
    _mnds_pp_info "git" "already up to date with origin/$destination"
    return 0
  fi

  if (( mine > 1 )); then
    _mnds_pp_info "git" "interactive rebase onto origin/$destination ($incoming new, $mine of mine)..."
    git rebase -i "origin/$destination" || __git_rbm_abort_on_conflict
    return
  fi

  _mnds_pp_info "git" "rebasing onto origin/$destination ($incoming new commits)..."
  git rebase "origin/$destination" || __git_rbm_abort_on_conflict
}

#
# main script
#

main() {
  zparseopts -D -E -- -stack=stack -reattach=reattach

  if [[ -n "$reattach" ]]; then
    _mnds_pp_info "git" "reattaching worktrees..."
    __git_rbm_reattach
    return
  fi

  local destination=$1
  [[ -n "$destination" ]] || destination=$(__git_rbm_infer_destination)

  local branch=$(git rev-parse --abbrev-ref HEAD)

  _mnds_pp_info "git" "fetching origin/$destination..."
  git fetch --quiet origin "$destination"

  __git_rbm_advance_destination "$destination" \
    || _mnds_pp_warn "git" "left local $destination alone: $(__git_rbm_refusal_reason $destination)"

  if [[ -n "$stack" ]]; then
    _mnds_pp_info "git" "detaching stack worktrees so their refs can move..."
    __git_rbm_detach "$destination"
  fi

  __git_rbm_rebase "$destination"

  [[ -n "$stack" ]] && __git_rbm_reattach

  _mnds_pp_success "git" "$branch is up to date with origin/$destination"
}

main "$@"
