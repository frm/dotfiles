#!/usr/bin/env sh
# removes a worktree, deletes local dir, and deletes local branch
# usage: git worktree-del [-f] <branch>
# -f: also delete the remote branch

set -e

. "$DOTFILES/git/lib/worktree.sh"

#
# aux functions
#

__echo_git() {
  echo "[git]: $1" >&2
}

__git_wt_get_worktree_path() {
  local branch_name="$1"

  git worktree list --porcelain \
    | grep -B2 "^branch refs/heads/$branch_name$" \
    | grep "^worktree " \
    | cut -d' ' -f2
}

# Drop the databases this worktree owns. The names are recomputed from the
# worktree's own path and primary's base rather than trusted from the marker:
# the file is gitignored but writable by anything, and a tampered value would
# otherwise steer a drop at a shared or sibling database.
__git_wt_teardown_databases() {
  local worktree_path="$1"
  local primary_root="$2"
  local hash name base recorded expected suffix

  [ "$(__git_wt_marker_get "$worktree_path" .db_mode)" = "isolated" ] || return 0

  hash=$(__git_wt_hash_id "$(cd "$worktree_path" && pwd -P)")

  for name in $(__git_wt_vars_by_strategy database); do
    recorded=$(__git_wt_marker_var "$worktree_path" "$name")
    base=$(__git_wt_resolve_env "$primary_root" "$name")

    [ -n "$recorded" ] && [ -n "$base" ] || continue

    expected="${base}_${hash}"
    if [ "$recorded" != "$expected" ]; then
      __echo_git "refusing to drop '$recorded': expected '$expected' for this worktree"
      continue
    fi

    for suffix in $_WT_DB_SUFFIXES; do
      __git_wt_db_exists "${recorded}${suffix}" || continue
      __echo_git "dropping ${recorded}${suffix}"
      __git_wt_db_drop "${recorded}${suffix}" || true
    done
  done
}

# Free the ports this worktree owns. Derived from its path, never read from the
# marker, so a tampered file cannot point this at an arbitrary local service.
__git_wt_teardown_ports() {
  local worktree_path="$1"
  local hash port_count index name port pids

  port_count=$(__git_wt_vars_by_strategy port | wc -l | tr -d ' ')
  [ "$port_count" -gt 0 ] || return 0

  hash=$(__git_wt_hash_id "$(cd "$worktree_path" && pwd -P)")
  index=0

  for name in $(__git_wt_vars_by_strategy port); do
    port=$(__git_wt_derive_port "$hash" "$index" "$port_count")
    index=$((index + 1))

    pids=$(lsof -nP -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null || true)
    [ -n "$pids" ] || continue

    __echo_git "freeing port $port ($name)"
    # Unquoted: lsof returns one pid per line.
    # shellcheck disable=SC2086
    kill -9 $pids 2>/dev/null || true
  done
}

__git_wt_teardown() {
  local worktree_path="$1"
  local primary_root

  __git_wt_marker_exists "$worktree_path" || return 0
  primary_root=$(__git_wt_primary_root)
  __git_wt_load_config "$primary_root"

  __git_wt_run_hook worktree-teardown "$worktree_path" "$primary_root" || true
  __git_wt_teardown_databases "$worktree_path" "$primary_root"
  __git_wt_teardown_ports "$worktree_path"
}

__git_wt_remove_worktree() {
  local worktree_path="$1"

  __echo_git "removing worktree at $worktree_path"

  # --force twice: the first covers a dirty tree, the second the untracked
  # files provisioning generated (env file, marker, logs). git still refuses
  # when submodules or nested checkouts are present, so fall back to removing
  # the directory ourselves and pruning the administrative entry.
  if ! git worktree remove --force --force "$worktree_path"; then
    __echo_git "git declined; removing $worktree_path directly"
    rm -rf "$worktree_path"
    git worktree prune
  fi
}

__git_wt_delete_local_branch() {
  local branch_name="$1"

  __echo_git "deleting local branch '$branch_name'"
  git branch -D "$branch_name"
}

__git_wt_delete_remote_branch() {
  local branch_name="$1"

  if git ls-remote --exit-code --heads origin "$branch_name" >/dev/null 2>&1; then
    __echo_git "deleting remote branch '$branch_name'"
    git push origin --delete "$branch_name"
  else
    __echo_git "no remote branch found for '$branch_name', skipping"
  fi
}

#
# main script
#

delete_remote=false

while getopts "f" opt; do
  case $opt in
    f) delete_remote=true ;;
    *) ;;
  esac
done
shift $((OPTIND - 1))

if [ -z "$1" ]; then
  __echo_git "branch name required"
  echo "usage: git worktree-del [-f] <branch>" >&2
  exit 1
fi

branch_name="$1"
worktree_path=$(__git_wt_get_worktree_path "$branch_name")

if [ -z "$worktree_path" ]; then
  __echo_git "no worktree found for branch '$branch_name'"
  exit 1
fi

__git_wt_teardown "$worktree_path"
__git_wt_remove_worktree "$worktree_path"
__git_wt_delete_local_branch "$branch_name"

if [ "$delete_remote" = true ]; then
  __git_wt_delete_remote_branch "$branch_name"
fi

__echo_git "done"
