#!/usr/bin/env zsh
# builds a PR body from a commit message and the repo's PR template
#
# usage: git pr-body [-r rev] [-t template]
#   -r: commit to take the body from (default: HEAD)
#   -t: template path (default: auto-discovered)
#
# labeled blocks in the commit body (`Why:`, `How:`) are pasted into the
# template sections with matching headings, replacing their placeholders.
# labels and headings match through aliases: Why ↔ Motivation / Context /
# Problem / Background, How ↔ What / What changed / Changes / Implementation /
# Approach / Solution. every other section is kept as-is.
#
# fallbacks:
#   a block has no matching section → the whole body goes into the description
#                                     section (Description / Summary /
#                                     What changed / Overview)
#   no template                     → the commit body alone
#   no description section          → the body, a rule, then the whole template
#
# prints to stdout. the PR title is not this script's job — it's the commit
# subject, `git log -1 --pretty=format:%s`.

set -e

source "$DOTFILES/functions/helpers.zsh"

__git_prb_find_template() {
  local templates=(
    ".github/pull_request_template.md"
    ".github/PULL_REQUEST_TEMPLATE.md"
    "pull_request_template.md"
    "PULL_REQUEST_TEMPLATE.md"
    "docs/pull_request_template.md"
  )

  for template in "${templates[@]}"; do
    if [ -f "$template" ]; then
      echo "$template"
      return
    fi
  done
}

__git_prb_merge() {
  local template="$1"
  local body_file="$2"

  awk -v bodyfile="$body_file" '
    function trim(s) {
      sub(/^[ \t]+/, "", s)
      sub(/[ \t]+$/, "", s)
      return s
    }

    function strip_blank_lines(s) {
      sub(/^[ \t\n]+/, "", s)
      sub(/[ \t\n]+$/, "", s)
      return s
    }

    function canonical(s) {
      s = tolower(trim(s))
      sub(/:$/, "", s)
      if (s ~ /^(why|motivation|context|problem|background)$/) return "why"
      if (s ~ /^(how|what|what changed|changes|implementation|approach|solution)$/) return "how"
      return s
    }

    function is_heading(line) { return line ~ /^#+[ \t]/ }

    function heading_text(line) {
      sub(/^#+[ \t]*/, "", line)
      return trim(line)
    }

    function render(   i, skipping) {
      for (i = 1; i <= lines; i++) {
        if (skipping && is_heading(template[i])) skipping = 0
        if (skipping) continue
        print template[i]
        if (!(i in fill)) continue
        print ""
        print fill[i]
        print ""
        skipping = 1
      }
    }

    function fill_labeled_sections(   i, key, slot) {
      if (labeled == 0 || preamble != "") return 0
      for (i = 1; i <= lines; i++) {
        if (!is_heading(template[i])) continue
        key = canonical(heading_text(template[i]))
        if ((key in block) && !(key in slot)) slot[key] = i
      }
      for (key in block) if (!(key in slot)) return 0
      for (key in block) fill[slot[key]] = strip_blank_lines(block[key])
      return 1
    }

    function fill_description_section(   i) {
      for (i = 1; i <= lines; i++) {
        if (!is_heading(template[i])) continue
        if (tolower(heading_text(template[i])) !~ /^(description|summary|what changed|overview)$/) continue
        fill[i] = whole
        return 1
      }
      return 0
    }

    BEGIN {
      while ((getline line < bodyfile) > 0) {
        whole = whole (whole_lines++ ? "\n" : "") line
        if (line ~ /^[A-Za-z][A-Za-z ]*:[ \t]*$/) {
          label = canonical(line)
          labeled++
          block[label] = block[label] "\n"
          continue
        }
        if (label == "") preamble = preamble trim(line)
        else block[label] = block[label] line "\n"
      }
      close(bodyfile)
    }

    { template[++lines] = $0 }

    END {
      if (!fill_labeled_sections() && !fill_description_section()) exit 3
      render()
    }
  ' "$template"
}

zparseopts -D -E -- r:=rev t:=template

rev=${${(@)rev:#-r}:-HEAD}
template=${(@)template:#-t}
template=${template:-$(__git_prb_find_template)}

body_file=$(mktemp)
trap "rm -f '$body_file'" EXIT

git log -1 --pretty=format:%b "$rev" | sed -e :a -e '/^\n*$/{$d;N;};/\n$/ba' > "$body_file"

if [ ! -s "$body_file" ]; then
  _mnds_pp_error "git" "commit $rev has no body" >&2
  exit 1
fi

if [ -z "$template" ]; then
  /bin/cat "$body_file"
  exit 0
fi

if ! __git_prb_merge "$template" "$body_file"; then
  _mnds_pp_warn "git" "no description section in $template, appending template" >&2
  /bin/cat "$body_file"
  echo "\n---\n"
  /bin/cat "$template"
fi
