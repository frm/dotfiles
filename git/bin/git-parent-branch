#!/usr/bin/env zsh
# find the parent branch for HEAD or -b
#
# usage: git parent-branch [-b branch]
#   -b: branch to resolve the parent of (default: HEAD)
#
# resolution goes config, then fork point, then merge-base topology. the config
# entry is written by worktree-add and can be set by hand:
#
#   git config branch.<name>.parent <parent>

source "$DOTFILES/functions/helpers.zsh"

#
# aux functions
#

__git_pb_from_config() {
  git config --get "branch.$1.parent"
}

__git_pb_infer_base() {
  if git-branch-check main; then
    echo "main"
  elif git-branch-check master; then
    echo "master"
  fi
}

# whether a commit is already on the base branch. two branches meeting there
# didn't fork from each other, they just both came off the trunk.
__git_pb_on_base() {
  local commit="$1"
  local base="$2"

  [[ -n "$base" ]] || return 1

  git merge-base --is-ancestor "$commit" "$base" 2>/dev/null && return 0
  git merge-base --is-ancestor "$commit" "origin/$base" 2>/dev/null
}

# the commit a branch was created at, from the oldest entry in its own reflog.
# empty when the reflog has aged out or predates the clone.
__git_pb_fork_commit() {
  git reflog show "$1" --format='%H %gs' 2>/dev/null \
    | awk '/branch: Created from/ {commit = $1} END {print commit}'
}

__git_pb_nearest_containing() {
  local commit="$1"
  local branch="$2"

  git branch --contains "$commit" --format='%(refname:short)' 2>/dev/null | while read -r candidate; do
    [[ "$candidate" != "$branch" ]] || continue

    echo "$(git rev-list --count $commit..$candidate) $candidate"
  done | sort -k1,1n -k2,2 | head -n 1 | cut -d' ' -f2
}

# the fork commit names the parent exactly, but only while it's still in our
# history. a rebase leaves it dangling, and the branch that happens to hold it
# afterwards is unrelated to us.
__git_pb_from_fork_point() {
  local branch="$1"
  local base="$2"
  local fork=$(__git_pb_fork_commit "$branch")

  [[ -n "$fork" ]] || return 0
  git merge-base --is-ancestor "$fork" "$branch" 2>/dev/null || return 0

  if __git_pb_on_base "$fork" "$base"; then
    echo "$base"
    return 0
  fi

  __git_pb_nearest_containing "$fork" "$branch"
}

__git_pb_base_distance() {
  git rev-list --count "$1..$2" 2>/dev/null
}

# fallback for when the reflog is gone. the parent is the branch we diverged
# from most recently, so the one whose merge-base with us is the fewest commits
# back. candidates that meet us on the base branch aren't in our stack at all,
# and ones further from the base than we are are children rather than parents.
__git_pb_from_topology() {
  local branch="$1"
  local base="$2"
  local tip=$(git rev-parse "$branch")
  local reach=$(__git_pb_base_distance "$base" "$branch")

  git branch --format='%(refname:short)' | while read -r candidate; do
    [[ "$candidate" != "$branch" && "$candidate" != "$base" ]] || continue

    local merge_base=$(git merge-base "$candidate" "$branch" 2>/dev/null)
    [[ -n "$merge_base" && "$merge_base" != "$tip" ]] || continue
    ! __git_pb_on_base "$merge_base" "$base" || continue

    local distance=$(__git_pb_base_distance "$base" "$candidate")
    [[ -z "$reach" || -z "$distance" || $distance -lt $reach ]] || continue

    echo "$(git rev-list --count $merge_base..$branch) $candidate"
  done | sort -k1,1n -k2,2 | head -n 1 | cut -d' ' -f2
}

# a branch sitting directly on the trunk has the base as its parent, but only
# once topology has ruled out a nearer one — every branch meets the base
# somewhere, so this can't be part of the ranking.
__git_pb_from_base() {
  local branch="$1"
  local base="$2"

  [[ -n "$base" && "$branch" != "$base" ]] || return 0

  git merge-base "$base" "$branch" >/dev/null 2>&1 && echo "$base"
}

__git_pb_resolve() {
  local branch="$1"
  local base=$(__git_pb_infer_base)

  local parent=$(__git_pb_from_config "$branch")
  [[ -n "$parent" ]] || parent=$(__git_pb_from_fork_point "$branch" "$base")
  [[ -n "$parent" ]] || parent=$(__git_pb_from_topology "$branch" "$base")
  [[ -n "$parent" ]] || parent=$(__git_pb_from_base "$branch" "$base")

  if [[ -z "$parent" ]]; then
    _mnds_pp_error "git" "couldn't determine parent branch" >&2
    _mnds_pp_neutral "git" "set it with: git config branch.$branch.parent <parent>" >&2
    return 1
  fi

  echo "$parent"
}

#
# main script
#

main() {
  zparseopts -D -E -- {b,-branch}:=branch

  local target=${branch[2]}
  [[ -n "$target" ]] || target=$(git rev-parse --abbrev-ref HEAD)

  __git_pb_resolve "$target"
}

main "$@"
