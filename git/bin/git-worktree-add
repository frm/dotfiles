#!/usr/bin/env sh
# creates a worktree for a branch, sharing build artifacts and deriving
# per-worktree ports/identity
# usage: git worktree-add [--reset] <branch>
#        git worktree-add [--reset] --pr <number>
#
# --reset isolates the worktree's databases: each `database` var in _WT_VARS
# gets its own <base>_<hash>_dev / _test cloned from the source worktree's.

set -e

. "$DOTFILES/git/lib/worktree.sh"

#
# aux functions
#

__echo_git() {
  echo "[git]: $1" >&2
}

# normalize branch path to max depth 1
# author/issue-id/description/other -> author/issue-id-description-other
__git_wt_normalize_branch_path() {
  case "$1" in
    */*/*)
      # 2+ slashes: keep first segment, join rest with dashes
      first="${1%%/*}"
      rest="${1#*/}"
      echo "$first/$(echo "$rest" | tr '/' '-')"
      ;;
    *)
      # 0-1 depth: keep as is
      echo "$1"
      ;;
  esac
}

# lowercase new branches so a repo settles on one casing
# existing local/remote branches are used as-is
__git_wt_canonical_branch() {
  local branch_name="$1"

  if git show-ref --verify --quiet "refs/heads/$branch_name" \
    || git show-ref --verify --quiet "refs/remotes/origin/$branch_name"; then
    echo "$branch_name"
    return
  fi

  echo "$branch_name" | tr '[:upper:]' '[:lower:]'
}

# when we have a pr number instead, we use gh to extract the branch name
__git_wt_parse_opts_from_pr() {
  local pr_number="$1"
  local branch_name=""

  branch_name=$(gh pr view "$pr_number" --json headRefName -q '.headRefName') || {
    __echo_git "failed to fetch branch name for PR #$pr_number"
    return 1
  }

  __echo_git "PR #$pr_number -> branch: $branch_name"
  echo "$branch_name"
}

# Parse opts into globals rather than echoing: --reset has to outlive the call,
# which it wouldn't in a command substitution's subshell.
_RESET=false
_BRANCH_NAME=""

__git_wt_parse_opts() {
  while [ $# -gt 0 ]; do
    case $1 in
      --reset|-r)
        _RESET=true
        shift
        ;;
      --pr)
        _BRANCH_NAME=$(__git_wt_parse_opts_from_pr "$2") || return 1
        shift 2
        ;;
      *)
        _BRANCH_NAME=$(__git_wt_canonical_branch "$1")
        shift
        ;;
    esac
  done
}

# determine what the worktree path should be
# depending on whether or not we're in a worktree already
__git_wt_infer_worktree_path() {
  local git_root="$1"
  local branch_name="$2"
  local repo_name=$(basename "$git_root")
  local worktrees_base=""

  case "$git_root" in
    */.worktrees/*)
      # if already inside a .worktrees directory, create sibling
      # extract repo name from path: .worktrees/<repo>/<branch>
      local after_worktrees="${git_root#*/.worktrees/}"
      local wt_repo_name="${after_worktrees%%/*}"
      worktrees_base="${git_root%/.worktrees/*}/.worktrees/$wt_repo_name"
      ;;
    *)
      worktrees_base="$(dirname "$git_root")/.worktrees/$repo_name"
      ;;
  esac

  local worktree_dir=$(__git_wt_normalize_branch_path "$branch_name")
  echo "$worktrees_base/$worktree_dir"
}

__git_wt_mkdir() {
  mkdir -p "$(dirname "$1")"
}

# attach the created worktree directory either to a new branch
# or an existing one
__git_wt_attach() {
  local worktree_path="$1"
  local branch_name="$2"
  local remote_ref="refs/remotes/origin/$branch_name"

  if git show-ref --verify --quiet "refs/heads/$branch_name"; then
    # local branch exists, use it
    git worktree add "$worktree_path" "$branch_name"
  elif git show-ref --verify --quiet "$remote_ref"; then
    # remote branch exists (already fetched), track it
    git worktree add --track "$worktree_path" -b "$branch_name" "origin/$branch_name"
  elif git fetch origin "$branch_name:$remote_ref" 2>/dev/null && git show-ref --verify --quiet "$remote_ref"; then
    # remote branch exists (just fetched), track it
    git worktree add --track "$worktree_path" -b "$branch_name" "origin/$branch_name"
  else
    # new branch off the current worktree's HEAD, carrying its commits
    git worktree add "$worktree_path" -b "$branch_name"
  fi
}

#
# env setup
#

# Derive this worktree's values for every declared var and write them into its
# env file. Bases always come from the primary worktree, so branching off a
# worktree still yields nexus_<hash> rather than nexus_<hash>_<hash>.
#
# Emits NAME<TAB>VALUE<TAB>STRATEGY for the marker.
__git_wt_setup_vars() {
  local worktree_path="$1"
  local primary_root="$2"
  local hash="$3"
  local env_path="$worktree_path/$(__git_wt_env_file "$worktree_path")"
  local name strategy base value port_index port_count

  port_count=$(__git_wt_vars_by_strategy port | wc -l | tr -d ' ')
  port_index=0

  __git_wt_vars | while IFS="$_WT_TAB" read -r name strategy; do
    case "$strategy" in
      port)
        value=$(__git_wt_derive_port "$hash" "$port_index" "$port_count")
        port_index=$((port_index + 1))
        ;;
      unique)
        base=$(__git_wt_resolve_env "$primary_root" "$name")
        [ -n "$base" ] || {
          __echo_git "  $name: no value in primary, skipping"
          continue
        }
        value="${base}_${hash}"
        ;;
      database)
        base=$(__git_wt_resolve_env "$primary_root" "$name")
        [ -n "$base" ] || {
          __echo_git "  $name: no value in primary, skipping"
          continue
        }
        # Only a --reset worktree gets its own databases; without one the
        # derived name would point at a database nothing ever created.
        if [ "$_RESET" = true ]; then
          value="${base}_${hash}"
        else
          value="$base"
        fi
        ;;
    esac

    __git_wt_upsert_env "$env_path" "$name" "$value"
    __echo_git "  $name=$value"
    printf '%s\t%s\t%s\n' "$name" "$value" "$strategy"
  done

  # mise refuses to load a config it hasn't been told to trust, and we just
  # generated one.
  case "$env_path" in
    *.toml)
      command -v mise >/dev/null 2>&1 && mise trust --yes "$worktree_path" >/dev/null 2>&1 || true
      ;;
  esac
}

# Clone each `database` var's dev/test databases for this worktree. The
# template is the SOURCE worktree's database, not primary's: branching off a
# worktree means its migrations are the ones that match.
__git_wt_isolate_databases() {
  local worktree_path="$1"
  local source_root="$2"
  local name template target suffix

  command -v jq >/dev/null 2>&1 || {
    __echo_git "jq is required to isolate databases"
    return 1
  }

  local cloned=0

  for name in $(__git_wt_vars_by_strategy database); do
    template=$(__git_wt_resolve_env "$source_root" "$name")
    target=$(__git_wt_marker_var "$worktree_path" "$name")

    [ -n "$template" ] && [ -n "$target" ] || continue
    [ "$template" = "$target" ] && continue

    for suffix in $_WT_DB_SUFFIXES; do
      if ! __git_wt_db_exists "${template}${suffix}"; then
        __echo_git "  ${template}${suffix} does not exist, skipping"
        continue
      fi

      __echo_git "  cloning ${template}${suffix} -> ${target}${suffix}"
      __git_wt_db_clone "${template}${suffix}" "${target}${suffix}" || return 1
      cloned=$((cloned + 1))
    done
  done

  # Nothing cloned means the worktree has no databases of its own, so it must
  # not be recorded as isolated.
  [ "$cloned" -gt 0 ]
}

# Rewrite every database var back to primary's shared base. Echoes the updated
# marker rows.
__git_wt_reset_databases() {
  local worktree_path="$1" primary_root="$2" vars_tsv="$3"
  local env_path="$worktree_path/$(__git_wt_env_file "$worktree_path")"
  local name base

  for name in $(__git_wt_vars_by_strategy database); do
    base=$(__git_wt_resolve_env "$primary_root" "$name")
    [ -n "$base" ] || continue
    __git_wt_upsert_env "$env_path" "$name" "$base"
    __echo_git "  $name=$base"
  done

  printf '%s' "$vars_tsv" | awk -F'\t' -v OFS='\t' -v base="$base" '
    $3 == "database" { $2 = base }
    { print }'
}

#
# artifacts
#

# Everything worth sharing with the new worktree: secrets and the env file,
# whatever language detection finds, and the repo's own additions.
__git_wt_artifact_paths() {
  local git_root="$1"

  printf '%s\n' $_WT_ALWAYS_COPY
  __git_wt_env_file "$git_root"
  __git_wt_detect_paths "$git_root"
  printf '%s\n' $_WT_COPY
}

# clonefile: the copy shares data blocks with the source until one side is
# written, so a multi-GB _build costs no disk and no data movement. It fails
# outright when it can't clone (non-APFS, cross-volume), hence the fallback.
__git_wt_cp() {
  cp -ca "$1" "$2" 2>/dev/null || cp -a "$1" "$2"
}

# Language server caches bake absolute paths into build/, so it is worthless in
# a new worktree and expensive to walk.
__git_wt_cp_skip_build() {
  local src="$1" dest="$2"
  local entry

  mkdir -p "$dest"
  for entry in "$src"/* "$src"/.[!.]*; do
    [ -e "$entry" ] || continue
    [ "$(basename "$entry")" = "build" ] && continue
    __git_wt_cp "$entry" "$dest/" || return 1
  done
}

__git_wt_cp_artifact() {
  local item="$1" git_root="$2" worktree_path="$3"
  local rel_path="${item#$git_root/}"
  local dest="$worktree_path/$rel_path"
  local skip

  # already provisioned: never clobber an existing worktree's build state
  [ -e "$dest" ] && return 0

  mkdir -p "$(dirname "$dest")"

  for skip in $_WT_SKIP_BUILD; do
    if [ "$(basename "$item")" = "$skip" ]; then
      __git_wt_cp_skip_build "$item" "$dest"
      return $?
    fi
  done

  __git_wt_cp "$item" "$dest"
}

# Copies run concurrently and are joined by the caller: clonefile moves no data
# but still walks every inode, so overlapping them is a large wall-clock win.
__git_wt_cp_artifacts() {
  local git_root="$1"
  local worktree_path="$2"
  local pids="" failed=0

  for pattern in $(__git_wt_artifact_paths "$git_root"); do
    for item in $git_root/$pattern; do
      [ -e "$item" ] || continue
      __git_wt_cp_artifact "$item" "$git_root" "$worktree_path" &
      pids="$pids $!"
    done
  done

  __git_wt_spinner "$pids" "sharing artifacts"

  for pid in $pids; do
    wait "$pid" || failed=1
  done

  return $failed
}

__git_wt_spinner() {
  local pids="$1" label="$2"
  local i=0 c pid running

  # Carriage-return animation only makes sense on a terminal; piped output
  # would collect one line per frame.
  if [ ! -t 2 ]; then
    __echo_git "$label..."
    return
  fi

  while :; do
    running=false
    for pid in $pids; do
      kill -0 "$pid" 2>/dev/null && running=true && break
    done
    [ "$running" = true ] || break

    case $((i % 10)) in
      0) c='⠋' ;; 1) c='⠙' ;; 2) c='⠹' ;; 3) c='⠸' ;; 4) c='⠼' ;;
      5) c='⠴' ;; 6) c='⠦' ;; 7) c='⠧' ;; 8) c='⠇' ;; 9) c='⠏' ;;
    esac
    printf '\r       %s %s...' "$c" "$label" >&2
    i=$((i + 1))
    sleep 0.1
  done

  printf '\r       \033[K' >&2
}

#
# setup
#

# Install deps for every detected project that owns a lockfile. A marker
# without one belongs to a workspace whose root installs on its behalf.
__git_wt_install_deps() {
  local worktree_path="$1"
  local lang dir target install_cmd

  __git_wt_detect "$worktree_path" | while IFS="$_WT_TAB" read -r lang dir; do
    target="$worktree_path${dir:+/$dir}"
    __git_wt_has_lockfile "$target" "$lang" || continue

    case "$lang" in
      elixir)
        __echo_git "[elixir:$dir] fetching deps..."
        (cd "$target" && mix deps.get && MIX_ENV=test mix deps.get)
        # Compiled in its own pass before the app, and repeated on failure.
        # Some deps decide what to define based on whether another dep is
        # loaded (absinthe omits its dataloader helpers if Dataloader wasn't
        # loaded when it compiled), which a shared _build can bake in until
        # something forces a rebuild.
        __echo_git "[elixir:$dir] compiling..."
        (
          cd "$target" || exit 1
          for env in dev test; do
            MIX_ENV="$env" mix deps.compile || exit 1
            MIX_ENV="$env" mix compile || MIX_ENV="$env" mix compile || exit 1
          done
        )
        ;;
      node)
        __echo_git "[node:$dir] installing deps..."
        install_cmd=$(__git_wt_node_install_cmd "$target")
        # Unquoted: the helper returns a command plus its subcommand.
        # shellcheck disable=SC2086
        (cd "$target" && $install_cmd)
        ;;
      python)
        __echo_git "[python:$dir] syncing venv..."
        (cd "$target" && uv sync)
        ;;
    esac
  done
}

__git_wt_notify() {
  local title="$1"
  local message="$2"
  osascript -e "display notification \"$message\" with title \"$title\""
}

# Deps and the repo's own hook run in the background: they are the slow part
# and nothing else depends on them.
__git_wt_setup_async() {
  local worktree_path="$1"
  local git_root="$2"
  local branch_name="$3"
  local hash="$4"
  local log_file="$worktree_path/.log/git-wt-setup.log"

  mkdir -p "$worktree_path/.log"

  (
    set +e
    _wt_ok=true

    __git_wt_install_deps "$worktree_path" || _wt_ok=false

    if [ "$_wt_ok" = true ]; then
      _WT_HASH="$hash" _WT_RESET="$_RESET" \
        __git_wt_run_hook worktree-setup "$worktree_path" "$git_root" || _wt_ok=false
    fi

    if [ "$_wt_ok" = true ]; then
      __git_wt_notify "Worktree ready" "Setup finished for $branch_name"
    else
      __git_wt_notify "Worktree setup failed" "Check $log_file"
    fi
  ) >> "$log_file" 2>&1 &

  __echo_git "installing deps in background (log: $log_file)"
}

# pull latest changes if on main/master to ensure worktree starts fresh
__git_wt_pull_if_default_branch() {
  local current_branch
  current_branch=$(git rev-parse --abbrev-ref HEAD)

  if [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ]; then
    __echo_git "on $current_branch, pulling latest changes..."
    git pull || __echo_git "pull failed, creating the worktree from local HEAD"
  fi
}

# Seed the sample hooks so the mechanism is discoverable. Samples are not
# executable, which is what marks a hook as unconfigured.
__git_wt_seed_hook_samples() {
  local hooks_dir sample name
  hooks_dir=$(__git_wt_hooks_dir) || return 0

  for name in worktree-setup worktree-teardown; do
    sample="$DOTFILES/git/git_template/hooks/${name}.sample"
    [ -f "$sample" ] || continue
    [ -e "$hooks_dir/${name}.sample" ] && continue
    cp "$sample" "$hooks_dir/${name}.sample"
  done
}

#
# main script
#

__git_wt_parse_opts "$@" || exit 1
branch_name="$_BRANCH_NAME"

if [ -z "$branch_name" ]; then
  __echo_git "branch name required"
  echo "usage: git worktree-add [--reset] <branch>" >&2
  echo "       git worktree-add [--reset] --pr <number>" >&2
  exit 1
fi

git_root=$(git rev-parse --show-toplevel)
primary_root=$(__git_wt_primary_root)
__git_wt_load_config "$primary_root"
worktree_path=$(__git_wt_infer_worktree_path "$git_root" "$branch_name")

if __git_wt_marker_exists "$worktree_path"; then
  __echo_git "worktree already provisioned at $worktree_path"
  echo "$worktree_path"
  exit 0
fi

if [ -d "$worktree_path" ]; then
  __echo_git "resuming unfinished worktree at $worktree_path"
else
  __git_wt_pull_if_default_branch
  __echo_git "creating worktree at $worktree_path"
  __git_wt_mkdir "$worktree_path"
  __git_wt_attach "$worktree_path" "$branch_name"
fi

hash=$(__git_wt_hash_id "$(cd "$worktree_path" && pwd -P)")

__git_wt_seed_hook_samples

if ! __git_wt_cp_artifacts "$git_root" "$worktree_path"; then
  __echo_git "an artifact failed to copy; re-run to resume"
  exit 1
fi

__echo_git "deriving worktree identity ($hash):"
vars_tsv=$(__git_wt_setup_vars "$worktree_path" "$primary_root" "$hash")

# The marker doubles as the "provisioned" flag, so it is written only once
# everything that can fail has succeeded.
__git_wt_marker_write "$worktree_path" "$hash" shared "$vars_tsv"

if [ "$_RESET" = true ]; then
  __echo_git "isolating databases:"
  if __git_wt_isolate_databases "$worktree_path" "$git_root"; then
    __git_wt_marker_write "$worktree_path" "$hash" isolated "$vars_tsv"
  else
    # Point the worktree back at the shared databases: its derived names were
    # written ahead of the clone and now name databases that don't exist.
    __echo_git "database isolation failed; falling back to the shared databases"
    vars_tsv=$(__git_wt_reset_databases "$worktree_path" "$primary_root" "$vars_tsv")
    __git_wt_marker_write "$worktree_path" "$hash" shared "$vars_tsv"
  fi
fi

__git_wt_setup_async "$worktree_path" "$git_root" "$branch_name" "$hash"

__echo_git "worktree created at $worktree_path"
echo "$worktree_path"
